# =====================================================================
# Ortam değişkenleri — örnek dosya
#
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env.local` ve tüm `.env*` dosyaları .gitignore'dadır; asla commit
# edilmez. Bu dosyada da DEĞER bulunmamalıdır, yalnızca alan adları.
#
# Üretimde bu değerler Vercel → Settings → Environment Variables
# altında **Production ve Preview** için tanımlıdır.
# Devir ve rotasyon ayrıntıları: docs/DEVIR-TESLIM.md
# =====================================================================


# ── Yönetim paneli ───────────────────────────────────────────────────
# /admin girişindeki tek paylaşımlı şifre. Uzun ve rastgele olmalı:
# giriş ucu herkese açık ve tek gerçek savunma şifrenin gücüdür.
ADMIN_PASSWORD=

# Oturum jetonlarını imzalayan anahtar (HS256). Hem müşteri hem yönetici
# oturumu bununla imzalanır. Değiştirilince tüm oturumlar düşer.
SESSION_SECRET=


# ── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API. Yeni anahtar sistemine geçildiyse
# publishable/secret anahtarlar kullanılır (bkz. docs/DEVIR-TESLIM.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS'i baypas eder — yalnızca sunucu tarafında kullanılır. Adında
# NEXT_PUBLIC bulunmaması bu yüzden kritik; tarayıcıya sızmamalı.
SUPABASE_SERVICE_ROLE_KEY=


# ── Site ─────────────────────────────────────────────────────────────
# Canonical adresler, PayTR yönlendirmeleri, sitemap ve e-posta
# bağlantıları bu değerden üretilir. Üretimde https://dunyanincicegi.com,
# yerelde http://localhost:3000. Yanlış değer SEO'yu ve ödeme dönüşünü bozar.
NEXT_PUBLIC_SITE_URL=


# ── Web Push (yönetici bildirimleri) ─────────────────────────────────
# VAPID anahtar çifti. Bir kez üretilir; değiştirilirse kayıtlı tüm cihaz
# abonelikleri geçersiz olur ve yeniden abone olmak gerekir.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# ── E-posta (Resend) ─────────────────────────────────────────────────
# Sipariş onayı ve şifre sıfırlama e-postaları. Sipariş onay e-postası
# Mesafeli Sözleşmeler Yönetmeliği uyarınca Ön Bilgilendirme Formu ve
# Mesafeli Satış Sözleşmesi nüshalarını da taşır; bu servisin çalışması
# yasal bir yükümlülüktür.
RESEND_API_KEY=


# ── e-Arşiv fatura (Kolaysoft) ───────────────────────────────────────
# DİKKAT: test ve gerçek hesap ayrıdır. Test hesabıyla canlıya çıkmak
# gerçek siparişlere geçersiz fatura kesilmesine yol açar — sistem
# "başarılı" der, yasal fatura oluşmaz.
KOLAYSOFT_USERNAME=
KOLAYSOFT_PASSWORD=
KOLAYSOFT_BASE_URL=

# Fatura numarası ön eki. Kolaysoft panelinde TANIMLI olmalı, aksi hâlde
# gönderim reddedilir. Numaralandırma buna bağlı — DEĞİŞTİRİLMEMELİ.
KOLAYSOFT_DOCUMENT_PREFIX=DCC


# ── Kartla ödeme (PayTR iFrame API) ──────────────────────────────────
# Mağaza Paneli → Bilgi sayfasından alınır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# 0 = canlı (gerçek tahsilat), 1 = test.
# Değişken TANIMLI DEĞİLSE kod bilinçli olarak TEST moduna varsayar —
# ters varsayım, mağaza canlı moda geçmemişken her ödemeyi hataya düşürürdü.
# Üretimde 0 olmalı; eksik kalırsa müşteriden para çekilmez ve sipariş
# "Ödeme Bekleyen"de kalır. Kontrol: /admin/odeme-ayarlari kutusu yeşil mi.
PAYTR_TEST_MODE=0


# ── SMS (NetGSM) ─────────────────────────────────────────────────────
# Görsel onay ve "kargoya verildi" bildirimleri. Bu iki mesaj 6563 sayılı
# Kanun anlamında ticari elektronik ileti değil, işlem bildirimidir;
# dolayısıyla İYS onayı gerektirmez.
NETGSM_USERCODE=
NETGSM_PASSWORD=

# NetGSM panelinde ONAYLANMIŞ Gönderici Adı ile birebir aynı olmalı.
# Farklıysa NetGSM 40 kodu döndürür ("mesaj başlığı tanımlı değil").
NETGSM_HEADER=
